# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses a SQLite file -- no server to install.
DATABASE_URL="file:./prisma/dev.db"
#
# For production (Supabase / Neon / any Postgres), set provider = "postgresql"
# in prisma/schema.prisma, swap the adapter in src/lib/db.ts, then use:
# DATABASE_URL="postgresql://user:password@host:5432/satos?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Set this to open the one-time owner signup route. Once your account exists,
# remove it: signup refuses to run when a user already exists.
ALLOW_SIGNUP="true"

# ---------------------------------------------------------------------------
# AI tutor (optional -- the app runs fully without these)
# ---------------------------------------------------------------------------
# Provider is chosen per user in Settings. Supply a key for whichever you use.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides. Sensible defaults live in src/lib/ai/providers.
ANTHROPIC_MODEL=""
OPENAI_MODEL=""
